# Copy to .env and edit if you want non-default ports/models.
POSTGRES_DB=paperviz
POSTGRES_USER=paperviz
POSTGRES_PASSWORD=paperviz
# 5433, not 5432: another local stack may already own the default port.
# Only the host-side mapping changes; containers still talk to postgres:5432.
POSTGRES_PORT=5433

# llama3.1:8b (~4.7GB Q4) fits entirely in 8GB VRAM.
# qwen2.5:14b (~9GB) is better at structured output but will spill to CPU on an 8GB card.
# Swapping the model is a config-only change — no code edits.
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_PORT=11434

GROBID_PORT=8070
RENDER_PORT=8000
BACKEND_PORT=8080
FRONTEND_PORT=4200
LOG_LEVEL=info
